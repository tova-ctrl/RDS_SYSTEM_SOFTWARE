# makefile.targets – user-managed, NOT regenerated by STM32CubeIDE.
# Included by Debug/makefile at line 104 (after the auto-generated link rule).
# This definition OVERRIDES the linker from arm-none-eabi-gcc to arm-none-eabi-g++
# and adds -lstdc++ -lsupc++ inside --start-group so C++ runtime initialises
# correctly without linker-ordering issues.
#
# GNU Make: when a target has multiple single-colon rules, the LAST recipe wins.
# This file is included after the link rule in Debug/makefile, so this recipe wins.

# IsmCanTransport.cpp is not in Eclipse's auto-generated objects.list.
# Adding it here keeps it linked even after Clean+Build.
USER_OBJS += ./Core/Src/IsmCanTransport.o

./Core/Src/IsmCanTransport.o: ../Core/Src/IsmCanTransport.cpp
	arm-none-eabi-g++ "$<" -mcpu=cortex-m7 -std=gnu++17 -g3 -DDEBUG -DUSE_PWR_LDO_SUPPLY -DUSE_HAL_DRIVER -DSTM32H753xx -c -I../LWIP/App -IC:/Projects/RDS_SYSTEM_SOFTWARE/ISM_Firmware/include -I../LWIP/Target -I../Core/Inc -I../Middlewares/Third_Party/LwIP/src/include -I../Middlewares/Third_Party/LwIP/system -I../Drivers/STM32H7xx_HAL_Driver/Inc -I../Drivers/STM32H7xx_HAL_Driver/Inc/Legacy -I../Drivers/BSP/Components/lan8742 -I../Middlewares/Third_Party/LwIP/src/include/netif/ppp -I../Drivers/CMSIS/Device/ST/STM32H7xx/Include -I../Middlewares/Third_Party/LwIP/src/include/lwip -I../Middlewares/Third_Party/LwIP/src/include/lwip/apps -I../Middlewares/Third_Party/LwIP/src/include/lwip/priv -I../Middlewares/Third_Party/LwIP/src/include/lwip/prot -I../Middlewares/Third_Party/LwIP/src/include/netif -I../Middlewares/Third_Party/LwIP/src/include/compat/posix -I../Middlewares/Third_Party/LwIP/src/include/compat/posix/arpa -I../Middlewares/Third_Party/LwIP/src/include/compat/posix/net -I../Middlewares/Third_Party/LwIP/src/include/compat/posix/sys -I../Middlewares/Third_Party/LwIP/src/include/compat/stdc -I../Middlewares/Third_Party/LwIP/system/arch -I../Drivers/CMSIS/Include -O0 -ffunction-sections -fdata-sections -Wall -fstack-usage -fcyclomatic-complexity -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" --specs=nano.specs -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb -o "$@"

ISM_STM32_Proj.elf ISM_STM32_Proj.map: $(OBJS) $(USER_OBJS) C:\Projects\RDS_SYSTEM_SOFTWARE\ISM_STM32\ISM_STM32_Proj\STM32H753ZITX_FLASH.ld makefile objects.list $(OPTIONAL_TOOL_DEPS)
	arm-none-eabi-g++ -o "ISM_STM32_Proj.elf" @"objects.list" $(USER_OBJS) $(LIBS) -mcpu=cortex-m7 -T"C:\Projects\RDS_SYSTEM_SOFTWARE\ISM_STM32\ISM_STM32_Proj\STM32H753ZITX_FLASH.ld" --specs=nosys.specs -Wl,-Map="ISM_STM32_Proj.map" -Wl,--gc-sections -static --specs=nano.specs -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb -Wl,--start-group -lc -lm -lstdc++ -lsupc++ -Wl,--end-group
	@echo 'Finished building target: $@'
	@echo ' '
