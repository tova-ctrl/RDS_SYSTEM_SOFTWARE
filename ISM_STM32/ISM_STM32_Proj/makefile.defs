# makefile.defs – user-managed, NOT regenerated by STM32CubeIDE.
# Adds C++ compilation rules for the ISM port.
# Included by Debug/makefile at line 39 (before the link rule).

# Include paths – identical to subdir.mk but with the correct 3-level path
# to ISM_Firmware (Debug/ is three levels below RDS_SYSTEM_SOFTWARE/).
ISM_INC := \
 -I../LWIP/App \
 -I../../../ISM_Firmware/include \
 -I../LWIP/Target \
 -I../Core/Inc \
 -I../Middlewares/Third_Party/LwIP/src/include \
 -I../Middlewares/Third_Party/LwIP/system \
 -I../Drivers/STM32H7xx_HAL_Driver/Inc \
 -I../Drivers/STM32H7xx_HAL_Driver/Inc/Legacy \
 -I../Drivers/BSP/Components/lan8742 \
 -I../Middlewares/Third_Party/LwIP/src/include/netif/ppp \
 -I../Drivers/CMSIS/Device/ST/STM32H7xx/Include \
 -I../Middlewares/Third_Party/LwIP/src/include/lwip \
 -I../Middlewares/Third_Party/LwIP/src/include/lwip/apps \
 -I../Middlewares/Third_Party/LwIP/src/include/lwip/priv \
 -I../Middlewares/Third_Party/LwIP/src/include/lwip/prot \
 -I../Middlewares/Third_Party/LwIP/src/include/netif \
 -I../Middlewares/Third_Party/LwIP/src/include/compat/posix \
 -I../Middlewares/Third_Party/LwIP/src/include/compat/posix/arpa \
 -I../Middlewares/Third_Party/LwIP/src/include/compat/posix/net \
 -I../Middlewares/Third_Party/LwIP/src/include/compat/posix/sys \
 -I../Middlewares/Third_Party/LwIP/src/include/compat/stdc \
 -I../Middlewares/Third_Party/LwIP/system/arch \
 -I../Drivers/CMSIS/Include

# C++ compiler flags – mirror the C flags in Core/Src/subdir.mk
ISM_CXXFLAGS := -mcpu=cortex-m7 -std=gnu++17 -g3 \
 -DDEBUG -DUSE_PWR_LDO_SUPPLY -DUSE_HAL_DRIVER -DSTM32H753xx \
 -c $(ISM_INC) -O0 -ffunction-sections -fdata-sections -Wall \
 --specs=nano.specs -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb \
 -MMD -MP

# Add C++ objects to USER_OBJS so they appear on the linker command line
USER_OBJS += \
 Core/Src/ism_glue.o \
 Core/Src/platform_stm32.o \
 Core/Src/IsmEmgLinkLwIP.o \
 Core/Src/IsmEthTransport.o \
 Core/Src/ISM.o

# Explicit rules beat the %.c pattern rule in Core/Src/subdir.mk
Core/Src/ism_glue.o: ../Core/Src/ism_glue.cpp
	arm-none-eabi-g++ $(ISM_CXXFLAGS) -MF"Core/Src/ism_glue.d" -MT"$@" "$<" -o "$@"

Core/Src/platform_stm32.o: ../Core/Src/platform_stm32.cpp
	arm-none-eabi-g++ $(ISM_CXXFLAGS) -MF"Core/Src/platform_stm32.d" -MT"$@" "$<" -o "$@"

Core/Src/IsmEmgLinkLwIP.o: ../Core/Src/IsmEmgLinkLwIP.cpp
	arm-none-eabi-g++ $(ISM_CXXFLAGS) -MF"Core/Src/IsmEmgLinkLwIP.d" -MT"$@" "$<" -o "$@"

Core/Src/IsmEthTransport.o: ../Core/Src/IsmEthTransport.cpp
	arm-none-eabi-g++ $(ISM_CXXFLAGS) -MF"Core/Src/IsmEthTransport.d" -MT"$@" "$<" -o "$@"

# ISM.cpp lives in ISM_Firmware – three levels above Debug/
Core/Src/ISM.o: ../../../ISM_Firmware/src/ISM.cpp
	arm-none-eabi-g++ $(ISM_CXXFLAGS) -MF"Core/Src/ISM.d" -MT"$@" "$<" -o "$@"

