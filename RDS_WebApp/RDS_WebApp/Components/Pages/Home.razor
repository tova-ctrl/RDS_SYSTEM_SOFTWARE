    // J1 (left stick) — continuous gimbal pan/tilt rate, °/sec. No on-screen
    // indicator needed for this one — confirmed requirement is discrete
    // buttons only (T1/B3/B4/S3/T2/B2/B5/B6), not the continuous/analog J1/J2
    // sticks (see [[mobilicom-controller-mapping]] memory). Throttled on the
    // JS side (joystickControl.js) — this fires at most ~10/sec, not every
    // frame, so no need to throttle again here.
    [JSInvokable]
    public Task OnJoystickRate(float rateAzDegPerSec, float rateElDegPerSec)
    {
       /*Tova 17.8.26 TRY if (targetLocked)
        {
            // The camera appears to ignore RateCommand while its own internal
            // Track mode is engaged (SetTrack was sent at lock time) — use
            // TrackerAdjustControls instead (pixels, not deg/sec; positive =
            // right/down per the SDK). Reuses the incoming rate value as a
            // stick-deflection proxy, rescaled to a small pixel nudge — J2's
            // smaller max deg/sec naturally stays a finer nudge than J1's.
            const float degPerSecToPixels = 2.0f;
            const float maxAdjustPixels = 30f;
            short moveX = (short)Math.Clamp(rateAzDegPerSec * degPerSecToPixels, -maxAdjustPixels, maxAdjustPixels);
            short moveY = (short)Math.Clamp(-rateElDegPerSec * degPerSecToPixels, -maxAdjustPixels, maxAdjustPixels);
            stkDirect.SetTrackerAdjust(moveX != 0 || moveY != 0, moveX, moveY);
            return Task.CompletedTask;
        }
        */
        stkDirect.SetRateX(rateAzDegPerSec);
        stkDirect.SetRateY(rateElDegPerSec);
        return Task.CompletedTask;
    }

    // T1 — camera lock. Two interaction models, chosen per-device by
    // joystickControl.js: the Logitech's LB is a real momentary button, so
    // OnJoystickLock() (below) is a TOGGLE — one press engages, the next
    // disengages, tracked via liveTracking.IsActive. The real Mobilicom's T1
    // is a maintained two-way switch reported as a single button whose own
    // raw value already IS the state (2026-08-19, user confirmed: button #7
    // reads 1 while engaged, back to 0 when switched off) — so
    // joystickControl.js calls OnJoystickLockEngage/Disengage DIRECTLY off
    // that button's rising/falling edge instead, no toggle memory needed
    // (an earlier design routed the switch's "backward" position through a
    // separate shared button (#23, also shared with T2) — unnecessary once
    // the switch's own falling edge already carries this exactly, and
    // ambiguous since #23 couldn't distinguish which switch moved; removed).
    //
    // OnJoystickLockEngage: SetTrack does the initial lock onto the
    // crosshair (screen center) and we confirm via real telemetry that the
    // camera acknowledged it, matching the vendor demo's own plain "Track"
    // button (see [[camera-sdk-command-mapping]] memory) — then
    // LiveTrackingService takes over with continuous YOLO-based
    // re-detection + corrective rate commands, since the camera's own
    // onboard tracker alone was confirmed too primitive to hold a lock
    // (drops within ~1s even on a high-contrast target — see
    // [[project-state]], 2026-08-11).
    [JSInvokable]
    public Task OnJoystickLockEngage()
    {
        // Isolation test (2026-08-12) disproved ConfigureTrackerGate/the 4-packet
        // burst as the cause of the CONTROL-port freeze — bare SetTrack alone
        // (matching QBee exactly) still froze it. Real culprit found via
        // Wireshark: joystickControl.js's J1/J2 heartbeat was flooding the
        // camera continuously even at rest (fixed there). Gate config is
        // legitimately needed for the lock to hold, so it's back.
       //==Tova ==17.8.26 stkDirect.ConfigureTrackerGate();
        stkDirect.SetTrack(0, 0);
        // 2026-08-12: was `await Task.Run(...)` — queuing this onto the shared
        // ThreadPool is unnecessary (it's a bounded ~200ms lock+P/Invoke call,
        // same as the two direct calls just above) and adds to ThreadPool
        // pressure that's suspect in today's freeze investigation (see
        // [[mobilicom-controller-mapping]] memory — an actual ISM COMM_LOSS
        // was observed mid-session).
        var (syncErr, status) = stkDirect.SyncTrackerStatus();
        Console.WriteLine($"[T1] syncErr={syncErr}, status={status} (0=NoTrack,1=TrackerOK,2=Prediction,3=TrackLoss)");
        if (syncErr == 0)
        {
            // TrackerStatus: 0=NoTrack, 1=TrackerOK, 2=Prediction, 3=TrackLoss
            bool cameraAckedLock = status == 1 || status == 2;
            if (cameraAckedLock)
            {
                targetLocked = true; //== Tova 16/8/26
                liveTracking.Start();
            }
            else
            {
                targetLocked = false; //== Tova 16/8/26
                Console.WriteLine("[T1] camera did not acknowledge lock — not starting LiveTrackingService");
            }
        }
        else
        {
            Console.WriteLine("[T1] SyncTrackerStatus failed — not starting LiveTrackingService");
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnJoystickLockDisengage()
    {
        liveTracking.Stop();
        //==Tova ==17.8.26  stkDirect.DisableTrackerGate();
        stkDirect.SetTrack(0, 0);  //==Tova ==17.8.26
        return Task.CompletedTask;
    }

    // Momentary-button toggle wrapper — used by the Logitech only (see above).
    [JSInvokable]
    public Task OnJoystickLock()
    {
        return liveTracking.IsActive ? OnJoystickLockDisengage() : OnJoystickLockEngage();
    }

    // T2 — fire system open/close, STANDBY ⇄ ARMED. Same two-interaction-model
    // split as T1 above: OnJoystickFireSystemToggle() is the Logitech's
    // momentary-button toggle; the Mobilicom's T2 (button #15, also a
    // maintained switch) drives OnJoystickArmEngage/Disengage directly off
    // its own rising/falling edge. Reuses the exact same EthernetService
    // commands as the existing ARM/SAF-C buttons in the WEAPON STATUS panel
    // (2026-08-12, user confirmed this mapping), so this arms/disarms the
    // real weapon, not a cosmetic toggle.
    //
    // 2026-08-20: ARM/LOCK coupling, user's explicit requirement — "if
    // BUTTON 15 is on, we're in ARMED+LOCK; releasing ARMED also releases
    // LOCKED". Arming engages the camera lock too (only if not already
    // locked — if it was already locked before arming, it must STAY locked,
    // not get re-triggered through the full lock sequence again, which
    // would needlessly resend SetTrack/ConfigureTrackerGate — see the
    // CONTROL-port-freeze history in [[mobilicom-controller-mapping]] memory
    // for why redundant lock commands are worth avoiding, not just
    // wasteful). Disarming always disengages the lock unconditionally
    // (DisengageLock-equivalent is safe to call even if not currently
    // locked). Applies uniformly to both devices, since both ultimately
    // call these same two methods.
    [JSInvokable]
    public async Task OnJoystickArmEngage()
    {
        if (!liveTracking.IsActive)
        {
            await OnJoystickLockEngage();
        }
        await ArmSystem();
    }

    [JSInvokable]
    public async Task OnJoystickArmDisengage()
    {
        await SetStandby();
        await OnJoystickLockDisengage();
    }

    [JSInvokable]
    public Task OnJoystickFireSystemToggle()
    {
        return svc.CurrentState == SystemState.ARMED ? OnJoystickArmDisengage() : OnJoystickArmEngage();
    }

    // B2 — RT — fire. Reuses the exact same handler as the existing on-screen
    // FIRE button (WEAPON STATUS panel), so the joystick trigger is not a
    // separate/parallel path — same guardrails (or lack thereof) as the
    // button already had.
    [JSInvokable]
    public Task OnJoystickFire() => Fire();

    public void Dispose() {
        svc.OnChange -= OnStateChanged;
        eth.OnChange -= OnStateChanged;
        detection.OnTargetDetected -= OnTargetDetected;
        _timer?.Dispose();
        _camLinkTimer?.Dispose();
        liveTracking.Stop();
        _ = JS.InvokeVoidAsync("stopVideoStream");
        _ = JS.InvokeVoidAsync("stopJoystickControl");
        _joystickRef?.Dispose();
    }
    private const float CAMERA_HFOV = 25.0f;  // degrees — update when Micro300 spec known
    private const float CAMERA_VFOV = 19.0f;  // degrees

    private async Task OnVideoClick(MouseEventArgs e)
    {
        // OffsetX/Y are CSS pixels relative to the overlay div, which fills the video-feed exactly.
        // Get the overlay div's rendered size to compute proportion from center.
        var size = await JS.InvokeAsync<SvgSize>("getSvgSize", "video-overlay");
        if (size.Width < 1 || size.Height < 1) return;

        // Offset from center of the rendered video area
        double dx = e.OffsetX - size.Width  / 2.0;
        double dy = e.OffsetY - size.Height / 2.0;

        // Convert proportion-from-center to angular offset
        double clickDeltaAz =  (dx / (size.Width  / 2.0)) * (CAMERA_HFOV / 2.0);
        double clickDeltaEl = -(dy / (size.Height / 2.0)) * (CAMERA_VFOV / 2.0);

        double targetAz = azimuth   + clickDeltaAz;
        double targetEl = elevation + clickDeltaEl;

        deltaAz        = clickDeltaAz;
        deltaEl        = clickDeltaEl;
        lock_azimuth   = targetAz;
        lock_elevation = targetEl;
        setAz          = targetAz;
        setEl          = targetEl;
        // Deliberately does NOT touch targetLocked — this designates a weapon-aim
        // point, it isn't the camera's own visual lock. targetLocked now means
        // exactly one thing: LiveTrackingService is actively tracking (see
        // OnTargetDetected/OnJoystickLock) — this used to also flip it on, which
        // made LOCKED light up on a plain click with no real tracking behind it.

        await eth.SetPositionAsync(targetAz, targetEl);
        svc.UpdateState(svc.CurrentState, $"CLICK→GIMBAL AZ:{targetAz:F1}° EL:{targetEl:F1}°");
    }

    private record SvgSize(double Width, double Height);

    private async Task SlaveToTarget()
    {
        setAz = lock_azimuth;
        setEl = lock_elevation;
        await eth.SetPositionAsync(lock_azimuth, lock_elevation);
        svc.UpdateState(svc.CurrentState, $"SLAVE→TARGET AZ:{lock_azimuth:F1}° EL:{lock_elevation:F1}°");
        // Deliberately does NOT touch targetLocked — see OnVideoClick's note.
    }

    private async Task HandleEthClick()
    {
        if (eth.Status == EthernetStatus.Connected)
        {
            EthDisconnect();    // קורא לפונקציית הניתוק שלך
        }
        else
        {
            await EthConnect(); // קורא לפונקציית החיבור שלך
        }
    }

