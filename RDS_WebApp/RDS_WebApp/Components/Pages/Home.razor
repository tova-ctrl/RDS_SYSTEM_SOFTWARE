    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Port confirmed via Wireshark (2026-08-01). Codec (H.264 vs H.265) is
            // auto-detected server-side per connection — see videoStream.js.
            await JS.InvokeVoidAsync("startVideoStream", "liveVideo", "liveVideoCanvas", 51000);
            _liveVideoOn = true;

            // Joystick control — see [[mobilicom-controller-mapping]] memory for
            // the full confirmed button map. Only S3 (zoom) is wired so far.
            _joystickRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("startJoystickControl", _joystickRef);

            // Wake up with a live picture instead of making the operator click
            // manually every time the page loads (user's explicit request,
            // 2026-08-09). Sensor power ON/OFF was abandoned (2026-08-10) — user
            // confirmed it doesn't work reliably even in QBee itself — so this
            // just ensures DTV is the active/primary channel, same as
            // ToggleActiveCamera, no power cycling. Fire-and-forget the command
            // (it doesn't block), then a short beat before the first telemetry read.
            stkDirect.SetPrimaryVideoChannel(2); // enum Camera: DTV
            _ = Task.Run(async () =>
            {
                await Task.Delay(500);
                await InvokeAsync(async () =>
                {
                    await RefreshCamTelemetry();
                });
            });

            StateHasChanged();
        }
    }

    // S3 (D-pad Up) — zoom in, held. Targets the Day/DTV channel — the one
