    // 2026-08-06: user confirmed Day/DTV over Thermal for this control).
    //
    // Uses StkDirectCameraService (PC -> camera control port directly, NOT
    // through the FCC relay) instead of CameraApiService, per user's request
    // 2026-08-08 — the FCC-relay zoom (cam.SetDayCameraCommandZoomCommand)
    // produced no visible effect on the live video at all, and the joystick
    // is the actual real-world usage path, so that's what needs to prove the
    // direct path out. If this DOES visibly zoom, switch back to `cam` once
    // the FCC-side bug is found — this direct path is a diagnostic stand-in,
    // not necessarily the permanent design (see StkDirectCameraService.cs's
    // note on real-deployment network topology).
    [JSInvokable]
    public Task OnJoystickZoomIn()
    {
        _zoomingIn = true;
        _zoomingOut = false;
