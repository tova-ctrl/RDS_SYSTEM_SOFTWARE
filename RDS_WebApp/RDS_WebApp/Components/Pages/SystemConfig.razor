    // משתנים למעקב אחר מצב הלחיצה
    private bool isZoomingIn = false;
    private bool isZoomingOut = false;

    // עיצוב כפתור לחוץ (דוגמה: רקע אפור כהה וטקסט לבן)
    private string DayBtnActiveStyle => DayBtnStyle + "; background-color: #333; color: #fff; transform: scale(0.98);";

    private void StartZoomIn()
    {
        isZoomingIn = true;
        stkDirect.SetDayZoom((int)ZoomChange.Zoomin);
    }
    private void StartZoomOut()
    {
        isZoomingOut = true;
        stkDirect.SetDayZoom((int)ZoomChange.Zoomout);
    }

    private void StopZoom()
    {
        isZoomingIn = false;
        isZoomingOut = false;
        stkDirect.SetDayZoom((int)ZoomChange.Nochange);
    }
}
