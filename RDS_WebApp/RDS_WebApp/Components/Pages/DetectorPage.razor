@page "/DetectorPage"
@rendermode InteractiveServer
@inject RDS_WebApp.Services.SystemControlService svc
@inject RDS_WebApp.Services.EthernetService eth
@using RDS_WebApp.Services
@inject ImageDetectorService Detector
@inject DetectionResultService DetectionResult

<div style="
    background-color: #212529;
    padding: 20px;
    border-radius: 16px;
    box-shadow: inset 0 0 20px #000, 0 10px 30px rgba(0,0,0,0.7);
    border: 4px solid #15181b;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    box-sizing: border-box;">

    <div style="font-size:1rem;font-weight:700;color:#d1b06a;font-family:Consolas,monospace;letter-spacing:0.1em;margin-bottom:12px;">
     Person Detector Page
    </div>
    <div class="container mt-2 text-center" dir="rtl">
        <!-- כותרת ראשית -->
        <h2 class="fw-bold">מערכת לזיהוי דמויות אדם בתמונה (YOLOv8)</h2>
        <p class="text-muted fs-5 mb-2">העלי קובץ תמונה (PNG/JPG) כדי לראות את השרת מזהה ומסמן בני אדם בזמן אמת</p>

        <!-- אזור העלאת הקובץ - שינינו ל-mt-1 כדי שיעלה הכי גבוה שאפשר -->
        <div class="mt-1 card p-4 shadow-sm border-0 bg-light" style="max-width: 500px; margin: 0 auto;">
            <div class="mb-3">
                <label class="form-label fw-bold d-block text-start mb-2">בחרי תמונה מהמחשב:</label>
                <InputFile OnChange="HandleFileSelected" class="form-control" accept=".png,.jpg,.jpeg" />
            </div>
            <!-- כפתור הניגודיות החדש מתווסף כאן בדיוק! -->
            <div class="mt-3 text-start">
                <label class="form-label fw-bold text-dark">רמת ניגודיות למודל: @contrastValue</label>
                <input type="range" class="form-range" min="1.0" max="2.5" step="0.1" @bind="contrastValue" @bind:event="oninput" />
            </div>
            <!-- אינדיקטור טעינה בזמן שה-GPU/CPU מעבד את התמונה -->
            @if (isProcessing)
            {
                <div class="d-flex align-items-center justify-content-center text-success mt-2">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    <span class="fw-bold">מפענח ומזהה דמויות, אנא המתיני...</span>
                </div>
            }
        </div>בקובץ או במודל -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-4" style="max-width: 500px; margin: 0 auto;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            </div>
        }

        <!-- הצגת התוצאה המעובדת ישירות על המסך ללא רענון עמוד -->
        @if (!string.IsNullOrEmpty(resultImageBase64))
        {
            <div class="mt-5 p-3 border rounded shadow-sm bg-white" style="max-width: 850px; margin: 0 auto;">
                <h4 class="text-success fw-bold mb-3">תוצאת העיבוד מהשרת:</h4>
                <div class="position-relative d-inline-block">
                    <img src="data:image/png;base64,@resultImageBase64" class="img-fluid rounded border shadow-sm" alt="Detected Result" />
                </div>
            </div>
        }
    </div>
</div>
@code {
    private string resultImageBase64 = "";
    private string errorMessage = "";
    private bool isProcessing = false;
    private float contrastValue = 1.4f;
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isProcessing = true;
            errorMessage = "";
            resultImageBase64 = "";

            // 1. קריאת הקובץ שהועלה ישירות לתוך זרם זיכרון (עד 15MB לתמונה)
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(memoryStream);
            byte[] inputBytes = memoryStream.ToArray();

            // 2. הרצת ה-ImageDetectorService שכתבנו ב-C#
            var result = Detector.DetectPeopleInBytes(inputBytes, contrastValue);

            // 3. המרת מערך הבייטים ל-Base64
            resultImageBase64 = Convert.ToBase64String(result.AnnotatedImage);

            // 4. שליחת המטרה הראשונה למסך הטקטי
            if (result.Boxes.Count > 0)
            {
                var best = result.Boxes[0];
                double centerX = best.X + best.Width  / 2.0;
                double centerY = best.Y + best.Height / 2.0;
                const double HFOV = 25.0, VFOV = 19.0;
                double deltaAz =  (centerX - result.OriginalWidth  / 2.0) / (result.OriginalWidth  / 2.0) * (HFOV / 2.0);
                double deltaEl = -(centerY - result.OriginalHeight / 2.0) / (result.OriginalHeight / 2.0) * (VFOV / 2.0);
                double svgX = centerX / result.OriginalWidth  * 800.0;
                double svgY = centerY / result.OriginalHeight * 500.0;
                DetectionResult.SetTarget(resultImageBase64, deltaAz, deltaEl, svgX, svgY);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"שגיאה בעיבוד התמונה: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}



